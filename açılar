const GridBackground = () => (
  <svg className="absolute inset-0 w-full h-full -z-10 opacity-[0.04]" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0f172a" strokeWidth="1"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)" />
  </svg>
);

// --- Okunabilir Açı Metni Bileşeni (Kritik Düzeltme) ---
// Yazıların çizgilerle karışmasını önler, beyaz bir fon ile yazıyı öne çıkarır.
const AngleText = ({ x, y, children, color = "#ef4444" }) => (
  <g>
    <circle cx={x} cy={y} r="16" fill="white" fillOpacity="0.85" className="shadow-sm" />
    <text x={x} y={y} fontSize="17" fill={color} fontWeight="900" textAnchor="middle" dominantBaseline="central">
      {children}
    </text>
  </g>
);

// --- Geometrik Çizim Bileşenleri (SVG) ---
const SVGDefs = () => (
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#334155" />
    </marker>
  </defs>
);

