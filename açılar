export default function AcilarOyunu() {
  const [gameState, setGameState] = useState('start'); 
  const [ruleIndex, setRuleIndex] = useState(0);
  const [questionIndex, setQuestionIndex] = useState(0);
  const [score, setScore] = useState(0);
  const [selectedOption, setSelectedOption] = useState(null);
  const [isCorrect, setIsCorrect] = useState(null);
  const [animateCard, setAnimateCard] = useState(false);

  const currentRule = rulesData[ruleIndex];
  const currentQuestion = currentRule?.questions[questionIndex];
  
  // İlk soruda ipucu göster
  const showHint = questionIndex === 0; 
  const totalQuestions = rulesData.length * 5;
  const currentQNumber = ruleIndex * 5 + questionIndex + 1;

  const triggerAnimation = () => {
    setAnimateCard(true);
    setTimeout(() => setAnimateCard(false), 400);
  };

  const startGame = () => {
    triggerAnimation();
    setGameState('intro');
  };

  const startRuleQuestions = () => {
    triggerAnimation();
    setGameState('playing');
  };

  const handleOptionClick = (option) => {
    if (selectedOption !== null) return;
    
    setSelectedOption(option);
    const correct = option === currentQuestion.correct;
    setIsCorrect(correct);
    
    if (correct) {
      setScore(s => s + 10);
    }

    setTimeout(() => {
      handleNext();
    }, 1800);
  };

  const handleNext = () => {
    setSelectedOption(null);
    setIsCorrect(null);
    triggerAnimation();

    if (questionIndex < 4) {
      setQuestionIndex(q => q + 1);
    } else {
      if (ruleIndex < rulesData.length - 1) {
        setRuleIndex(r => r + 1);
        setQuestionIndex(0);
        setGameState('intro');
      } else {
        setGameState('finished');
      }
    }
  };

  const restartGame = () => {
    triggerAnimation();
    setRuleIndex(0);
    setQuestionIndex(0);
    setScore(0);
    setGameState('start');
    setSelectedOption(null);
    setIsCorrect(null);
  };

  return (
    <div className="relative min-h-[100dvh] bg-slate-50 text-slate-800 font-sans p-2 md:p-4 flex flex-col items-center justify-center overflow-x-hidden overflow-y-auto z-0">
      <GridBackground />
      
      {/* Oyun Başlangıç Ekranı */}
      {gameState === 'start' && (
        <div className={`max-w-2xl w-full bg-white rounded-3xl shadow-2xl border border-slate-100 p-6 md:p-10 text-center transform transition-all duration-400 ${animateCard ? 'scale-95 opacity-0' : 'scale-100 opacity-100'}`}>
          <div className="w-20 h-20 md:w-28 md:h-28 bg-gradient-to-br from-blue-500 to-indigo-600 text-white rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-lg rotate-3 hover:rotate-6 transition-transform">
            <Target size={48} className="md:w-14 md:h-14" />
          </div>
          <h1 className="text-3xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-indigo-700 mb-4 md:mb-6">
            Açıların Kısa Yolları
          </h1>
          <p className="text-base md:text-xl text-slate-600 mb-8 leading-relaxed">
            7. Sınıf Geometri dünyasına hoş geldin! <br className="hidden md:block" />
            Paralel doğrular arasındaki <span className="font-bold text-blue-600">Z, U, M, Kalem Ucu ve Zikzak</span> kurallarını temiz görsellerle öğren, hafızana kazı ve rekorunu kır.
          </p>
          <button 
            onClick={startGame}
            className="group relative inline-flex items-center justify-center px-8 md:px-10 py-4 md:py-5 text-lg md:text-xl font-bold text-white transition-all duration-200 bg-blue-600 border border-transparent rounded-full hover:bg-blue-700 shadow-xl hover:shadow-2xl hover:-translate-y-1"
          >
            <Play size={24} className="mr-3 group-hover:scale-110 transition-transform" /> Oyuna Başla
          </button>
        </div>
      )}

      {/* Kural Öğrenme Ekranı */}
      {gameState === 'intro' && currentRule && (
        <div className={`max-w-4xl w-full bg-white rounded-3xl shadow-2xl overflow-hidden border border-slate-100 transition-all duration-400 ${animateCard ? 'translate-y-8 opacity-0' : 'translate-y-0 opacity-100'}`}>
          <div className="bg-gradient-to-r from-blue-600 to-indigo-600 p-6 md:p-8 text-white text-center relative overflow-hidden">
            <Sparkles className="absolute top-4 right-8 text-blue-300 opacity-50 hidden md:block" size={48} />
            <span className="inline-block bg-white/20 px-3 py-1 md:px-4 md:py-1.5 rounded-full text-xs md:text-sm font-bold tracking-widest uppercase mb-2 shadow-sm">
              Kural {ruleIndex + 1} / 5
            </span>
            <h2 className="text-3xl md:text-4xl font-black tracking-tight">{currentRule.name}</h2>
          </div>
          
          <div className="p-4 md:p-8">
            <div className="flex flex-col md:flex-row items-stretch gap-4 md:gap-8 mb-6 md:mb-8">
              <div className="flex-1 bg-white p-2 md:p-6 rounded-2xl border-2 border-slate-100 shadow-sm flex items-center justify-center h-48 md:h-auto">
                <currentRule.SvgComponent {...currentRule.introProps} />
              </div>
              <div className="flex-1 flex flex-col justify-center gap-4">
                <div className="bg-amber-50 border-l-4 border-amber-500 p-4 md:p-6 rounded-r-2xl shadow-sm">
                  <h3 className="text-amber-800 font-bold mb-1 md:mb-2 flex items-center gap-2"><Lightbulb size={18}/> Kuralın Mantığı</h3>
                  <p className="text-amber-900/80 font-medium text-base md:text-lg leading-relaxed">
                    {currentRule.description}
                  </p>
                </div>
                <div className="bg-emerald-50 border-2 border-emerald-200 p-4 md:p-6 rounded-2xl text-center shadow-sm relative overflow-hidden">
                  <span className="text-emerald-700 font-bold mb-1 block uppercase tracking-wider text-xs md:text-sm">Matematiksel İfade</span>
                  <span className="text-2xl md:text-3xl font-black text-emerald-600 drop-shadow-sm">{currentRule.formula}</span>
                </div>
              </div>
            </div>
            
            <button 
              onClick={startRuleQuestions}
              className="w-full bg-slate-800 hover:bg-slate-900 text-white text-lg md:text-xl font-bold py-4 md:py-5 px-8 rounded-2xl transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-3 group"
            >
              Anladım, Sorulara Geç <ArrowRight size={24} className="group-hover:translate-x-2 transition-transform" />
            </button>
          </div>
        </div>
      )}

      {/* Soru Çözüm Ekranı */}
      {gameState === 'playing' && currentRule && currentQuestion && (
        <div className={`max-w-5xl w-full flex flex-col gap-3 md:gap-5 transition-all duration-400 ${animateCard ? 'scale-95 opacity-0' : 'scale-100 opacity-100'}`}>
          
          {/* Üst Bilgi Barı */}
          <div className="flex justify-between items-center bg-white p-3 md:p-4 rounded-2xl shadow-sm border border-slate-100">
            <div className="flex items-center gap-3">
              <div className="hidden md:block text-slate-500 font-bold uppercase tracking-wider text-xs">İlerleme</div>
              <div className="w-24 md:w-48 h-2.5 bg-slate-100 rounded-full overflow-hidden shadow-inner">
                <div 
                  className="h-full bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-700 rounded-full"
                  style={{ width: `${(currentQNumber / totalQuestions) * 100}%` }}
                ></div>
              </div>
              <span className="text-sm md:text-base font-black text-slate-700 bg-slate-100 px-2 py-1 rounded-lg">{currentQNumber} / {totalQuestions}</span>
            </div>
            <div className="flex items-center gap-2 bg-gradient-to-r from-amber-200 to-yellow-400 text-yellow-900 px-3 md:px-5 py-1.5 md:py-2 rounded-xl font-black text-sm md:text-lg shadow-sm">
              <Trophy size={18} className="text-yellow-700" /> {score} Puan
            </div>
          </div>

          <div className="flex flex-col lg:flex-row gap-4 md:gap-6">
            {/* Soru Alanı */}
            <div className="flex-grow bg-white rounded-3xl shadow-xl p-5 md:p-8 border border-slate-100 relative">
              <h3 className="text-xl md:text-2xl font-bold text-slate-800 mb-4 md:mb-6 leading-tight">{currentQuestion.q}</h3>
              
              {/* Temiz SVG Alanı */}
              <div className="w-full max-w-[16rem] md:max-w-sm mx-auto mb-5 md:mb-8 bg-white p-3 md:p-4 rounded-2xl border-2 border-slate-100 shadow-sm relative">
                <currentRule.SvgComponent {...currentQuestion.props} />
              </div>

              <div className="grid grid-cols-2 gap-3 md:gap-5">
                {currentQuestion.options.map((opt, i) => {
                  let btnColor = "bg-white hover:bg-slate-50 text-slate-700 border-2 border-slate-200 shadow-sm hover:border-blue-300";
                  let animationClass = "";
                  
                  if (selectedOption !== null) {
                    if (opt === currentQuestion.correct) {
                      btnColor = "bg-emerald-500 text-white border-emerald-600 shadow-lg z-10 scale-105";
                      animationClass = selectedOption === opt ? "animate-[bounce_0.5s_ease-in-out]" : "";
                    } else if (opt === selectedOption) {
                      btnColor = "bg-red-500 text-white border-red-600 opacity-90 scale-95";
                      animationClass = "animate-[pulse_0.5s_ease-in-out]";
                    } else {
                      btnColor = "bg-slate-50 text-slate-400 border-slate-100 opacity-50";
                    }
                  }

                  return (
                    <button
                      key={i}
                      onClick={() => handleOptionClick(opt)}
                      disabled={selectedOption !== null}
                      className={`relative px-4 py-3 md:py-4 text-2xl md:text-3xl font-black rounded-2xl transition-all duration-300 flex justify-center items-center ${btnColor} ${animationClass}`}
                    >
                      {opt}°
                      {selectedOption !== null && opt === currentQuestion.correct && (
                        <Check className="absolute right-3 md:right-4 text-white drop-shadow-md" size={24} />
                      )}
                      {selectedOption === opt && opt !== currentQuestion.correct && (
                        <X className="absolute right-3 md:right-4 text-white drop-shadow-md" size={24} />
                      )}
                    </button>
                  );
                })}
              </div>

              {/* Sonuç Mesajı */}
              {selectedOption !== null && (
                <div className={`mt-5 md:mt-6 p-3 md:p-4 rounded-xl text-center font-bold text-base md:text-xl transform transition-all ${isCorrect ? 'bg-emerald-100 text-emerald-700 scale-100' : 'bg-red-100 text-red-700 scale-100'}`}>
                  {isCorrect ? '✨ Harika! Doğru Cevap.' : '💡 Hatalı Seçim. Doğrusu ekranda işaretlendi.'}
                </div>
              )}
            </div>

            {/* İpucu Yan Paneli */}
            {showHint ? (
              <div className="w-full lg:w-72 bg-gradient-to-b from-blue-50 to-white border-2 border-blue-200 rounded-3xl p-5 flex flex-col shadow-lg relative overflow-hidden">
                <div className="absolute top-0 right-0 w-24 h-24 bg-blue-100 rounded-bl-full -z-10"></div>
                <div className="flex items-center gap-2 text-blue-700 font-black text-lg md:text-xl mb-4">
                  <Lightbulb size={24} className="text-amber-500" fill="currentColor" />
                  <span>Kuralı Hatırla!</span>
                </div>
                <div className="bg-white p-2 rounded-xl mb-4 shadow-sm border border-blue-100 opacity-90 h-32 md:h-auto flex items-center justify-center">
                  <currentRule.SvgComponent {...currentRule.introProps} />
                </div>
                <div className="bg-blue-600 text-white p-3 rounded-xl text-center font-black text-xl shadow-inner mb-3">
                  {currentRule.formula}
                </div>
                <p className="text-xs md:text-sm text-blue-800/80 font-medium leading-relaxed mt-auto bg-blue-100/50 p-3 rounded-lg">
                  * Bu ipucu sadece <span className="font-bold text-blue-700">ilk soruda</span> görünür. Sonraki sorularda kuralı zihninden hatırlamalısın!
                </p>
              </div>
            ) : (
              <div className="hidden lg:flex w-72 bg-slate-100/80 backdrop-blur-sm border-2 border-slate-200 border-dashed rounded-3xl p-6 flex-col items-center justify-center text-center shadow-inner">
                 <div className="w-16 h-16 bg-white rounded-full flex items-center justify-center mb-4 shadow-sm">
                   <Target size={28} className="text-slate-300" />
                 </div>
                 <h4 className="font-black text-slate-500 text-lg mb-2">İpucu Gizlendi</h4>
                 <p className="text-sm text-slate-400 font-medium">Şimdi kuralı zihninden uygulayarak kendini test etme zamanı. Başarabilirsin!</p>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Oyun Bitiş Ekranı */}
      {gameState === 'finished' && (
        <div className={`max-w-md w-full bg-white rounded-3xl shadow-2xl p-8 md:p-10 text-center border border-slate-100 transition-all duration-700 ${animateCard ? 'translate-y-10 opacity-0' : 'translate-y-0 opacity-100'}`}>
          <div className="relative w-32 h-32 md:w-40 md:h-40 mx-auto mb-6 md:mb-8">
            <div className="absolute inset-0 bg-yellow-200 rounded-full animate-[ping_2s_cubic-bezier(0,0,0.2,1)_infinite] opacity-75"></div>
            <div className="relative w-full h-full bg-gradient-to-tr from-yellow-300 to-amber-500 rounded-full flex items-center justify-center shadow-lg border-4 border-white">
              <Trophy size={64} className="text-white drop-shadow-md" />
            </div>
          </div>
          <h2 className="text-3xl md:text-4xl font-black text-slate-800 mb-2 md:mb-3">Tebrikler!</h2>
          <p className="text-base md:text-lg text-slate-500 font-medium mb-6 md:mb-8">Tüm açı kurallarını başarıyla tamamladın ve harika bir iş çıkardın.</p>
          
          <div className="bg-slate-50 border-2 border-slate-100 rounded-2xl p-5 md:p-6 mb-6 md:mb-8 relative overflow-hidden">
            <div className="absolute top-0 left-0 w-2 h-full bg-blue-500"></div>
            <span className="block text-slate-500 font-bold mb-1 md:mb-2 uppercase tracking-wide text-xs md:text-sm">Kazanılan Puan</span>
            <span className="text-6xl md:text-7xl font-black text-blue-600 drop-shadow-sm">{score}</span>
            <span className="text-slate-400 font-medium block mt-2 md:mt-3 text-sm">Maksimum Puan: 250</span>
          </div>

          <button 
            onClick={restartGame}
            className="w-full bg-slate-800 hover:bg-slate-900 text-white text-lg md:text-xl font-bold py-4 md:py-5 px-8 rounded-2xl transition-all shadow-lg flex items-center justify-center gap-3 hover:-translate-y-1"
          >
            <RotateCcw size={24} /> Tekrar Oyna
          </button>
        </div>
      )}
    </div>
  );
}


